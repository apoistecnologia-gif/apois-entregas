# Frontend (public values only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_GOOGLE_MAPS_BROWSER_KEY=YOUR_BROWSER_RESTRICTED_GOOGLE_MAPS_KEY
VITE_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID

# Product build mode for separated releases:
# customer | merchant | courier | admin
# customer = app cliente; merchant = painel estabelecimento; courier = app entregador; admin = painel administrativo.
VITE_APOIS_PRODUCT_MODE=customer

# Server-only application runtime (never expose as VITE_*)
# Used by src/integrations/supabase/client.server.ts when server-side code needs
# privileged Supabase access. Keep this value out of browser bundles and client logs.
APOIS_SUPABASE_SERVICE_ROLE_KEY=

# Server-side Google Maps credential (never expose as VITE_*)
GOOGLE_MAPS_API_KEY=

# Supabase Edge Functions / server-side secrets
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.

# Current order payment provider. Use sandbox until the payment account is homologated;
# never point production traffic to sandbox credentials.
OPENPIX_ENVIRONMENT=sandbox
OPENPIX_APP_ID_SANDBOX=
OPENPIX_APP_ID_PRODUCTION=
OPENPIX_WEBHOOK_SECRET_SANDBOX=
OPENPIX_WEBHOOK_SECRET_PRODUCTION=

# Legacy/secondary Mercado Pago integration kept only where code still explicitly uses it.
MERCADO_PAGO_ENVIRONMENT=test
MERCADO_PAGO_API_URL=https://api.mercadopago.com
MERCADO_PAGO_ACCESS_TOKEN_TEST=
MERCADO_PAGO_ACCESS_TOKEN_PRODUCTION=
MERCADO_PAGO_WEBHOOK_SECRET_TEST=
MERCADO_PAGO_WEBHOOK_SECRET_PRODUCTION=

# Courier native push dispatcher (Supabase Edge Function: dispatch-push-outbox).
# PUSH_DISPATCH_WEBHOOK_SECRET must match the private Postgres runtime setting and must
# never be exposed to a VITE_* variable or committed with a real value.
PUSH_DISPATCH_WEBHOOK_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# GitHub Actions secret used only while packaging the Android courier app.
# Value = base64 of the Firebase google-services.json registered specifically for
# Android package br.com.apois.entregador.
FIREBASE_COURIER_GOOGLE_SERVICES_JSON_BASE64=
